    m_Metadata:
      m_Items: []
  - m_Id: 816990738280448
    m_Localized: "H\u0131zl\u0131 Bronz"
    m_Metadata:
      m_Items: []
  - m_Id: 816992281784320
    m_Localized: "Bronz paran\u0131n h\u0131z\u0131n\u0131 %10 art\u0131r\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 819931566141440
