  - m_Id: 812448386740224
    m_Localized: '-'
    m_Metadata:
      m_Items: []
  - m_Id: 812786665746432
    m_Localized: "Bronz Dalgas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 812788007923712
    m_Localized: Bronz para 1$ daha fazla verir
    m_Metadata:
      m_Items: []
  - m_Id: 813979420946432
