    m_Metadata:
      m_Items: []
  - m_Id: 829393777553408
    m_Localized: "Alt\u0131n paralar art\u0131k sadece \xFCzerine gelinerek \xE7evrilebilir"
    m_Metadata:
      m_Items: []
  - m_Id: 834044283416576
    m_Localized: "Lider tablosunu a\xE7mak i\xE7in 20k$ kazan"
