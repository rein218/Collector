    m_Metadata:
      m_Items: []
  - m_Id: 820543963885568
    m_Localized: "G\xFCm\xFC\u015F para 5$ daha fazla verir"
    m_Metadata:
      m_Items: []
  - m_Id: 821472180137984
    m_Localized: "G\xFCm\xFC\u015F Simyas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 821472779923456
    m_Localized: "G\xFCm\xFC\u015F para +%25 daha fazla $ verir"
    m_Metadata:
      m_Items: []
  - m_Id: 822088809934848
    m_Localized: "H\u0131zl\u0131 G\xFCm\xFC\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 822089510383616
    m_Localized: "G\xFCm\xFC\u015F paran\u0131n h\u0131z\u0131n\u0131 %10 art\u0131r\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 851298853154816
    m_Localized: "\xC7ift \xC7evirme \u015Eans\u0131 (G\xFCm\xFC\u015F)"
    m_Metadata:
      m_Items: []
  - m_Id: 851418470510592
    m_Localized: "G\xFCm\xFC\u015F paran\u0131n tekrar \xE7evrilme \u015Fans\u0131n\u0131
