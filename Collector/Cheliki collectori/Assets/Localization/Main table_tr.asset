  - m_Id: 810749077057536
    m_Localized: "Yard\u0131mc\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 810751119683584
    m_Localized: "Madeni paralar\u0131 otomatik olarak \xE7evirir"
